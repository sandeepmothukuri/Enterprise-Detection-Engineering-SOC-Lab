# ============================================================
#  Enterprise Detection Engineering SOC Lab — Environment
#  Copy to .env and set local lab credentials before startup.
# ============================================================

# ── OpenSearch SIEM Cluster ─────────────────────────────────
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_16
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601

# ── Network sensors ─────────────────────────────────────────
ZEEK_INTERFACE=auto
SURICATA_INTERFACE=eth0
SURICATA_HOME_NET="[172.20.0.0/16]"
SOC_NETWORK=172.20.0.0/16

# ── Vector Log Pipeline ─────────────────────────────────────
VECTOR_API_PORT=8686
VECTOR_SYSLOG_UDP=514
VECTOR_BEATS_PORT=5044
VECTOR_WINDOWS_PORT=6000
VECTOR_LINUX_PORT=6001
VECTOR_CLOUD_PORT=6002
VECTOR_ZEEK_PORT=6003
VECTOR_SURICATA_PORT=6004

# ── ElastAlert2 Detection Engine ────────────────────────────
ELASTALERT_SLACK_WEBHOOK=
ELASTALERT_EMAIL_SMTP=
ELASTALERT_EMAIL_FROM=
ELASTALERT_EMAIL_TO=

# ── StackStorm SOAR ──────────────────────────────────────────
ST2_AUTH_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_20
ST2_API_PORT=9101
ST2_AUTH_PORT=9102

# ── DFIR-IRIS Case Management ────────────────────────────────
IRIS_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
IRIS_ADMIN_PASSWORD=CHANGE_ME_SET_STRONG_PASSWORD
IRIS_ADM_API_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
IRIS_PORT=8443
IRIS_DB_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_16

# ── MISP Threat Intelligence ─────────────────────────────────
MISP_ADMIN_EMAIL=admin@soc.lab
MISP_ADMIN_PASSWORD=CHANGE_ME_SET_STRONG_PASSWORD
MISP_API_KEY=
MISP_BASEURL=http://localhost:8080
MISP_PORT=8080
MISP_DB_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_16
MISP_MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_16

# ── Velociraptor DFIR ────────────────────────────────────────
VELOCIRAPTOR_PORT=8889
VELOCIRAPTOR_API_PORT=8001
VELOX_USER=admin
VELOX_PASSWORD=CHANGE_ME_SET_STRONG_PASSWORD
VELOX_ROLE=administrator
VELOX_SERVER_URL=https://velociraptor:8000/
VELOX_FRONTEND_HOSTNAME=velociraptor

# ── MITRE Caldera Attack Simulation ──────────────────────────
CALDERA_PORT=8888
CALDERA_API_KEY_RED=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_20
CALDERA_API_KEY_BLUE=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_20
CALDERA_RED_PASS=CHANGE_ME_SET_STRONG_PASSWORD
CALDERA_BLUE_PASS=CHANGE_ME_SET_STRONG_PASSWORD

# ── Responder (Red Team Credential Capture) ──────────────────
RESPONDER_INTERFACE=eth0
RESPONDER_PORT=5355

# ── Ollama Local LLM ─────────────────────────────────────────
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b

# ── CrewAI Agent API ─────────────────────────────────────────
CREWAI_API_PORT=8500

# ── WebSocket Real-Time Streamer ─────────────────────────────
WS_PORT=8765

# ── SOC portal ───────────────────────────────────────────────
SOC_PORT=80
SOC_DOMAIN=soc.lab
