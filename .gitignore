# Environment — NEVER commit secrets
.env
.env.*
*.env.local
!.env.example

# Docker volumes / local runtime data
data/
volumes/
opensearch-data*/
responder-logs/
logs/

t1046-test.pcap

# Generated OpenSearch / local TLS material
config/opensearch/certs/
config/nginx/certs/

# Velociraptor generated keys/config
config/velociraptor/*.key
config/velociraptor/server.config.yaml
config/velociraptor/client.config.yaml

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# AI agent memory/cache
ai-agents/.crewai/
ai-agents/db/
ai-agents/*.db

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Caldera data
config/caldera/data/
config/caldera/plugins/*/data/
config/caldera/local.yml

# MISP keys
config/misp/*.pem
config/misp/gpg/

# Captured hashes — red team / sensitive
config/responder/logs/
responder-logs/NTLMv2*
responder-logs/NTLMv1*

# Certificates / private keys
*.key
*.pem
*.pfx
*.p12

# Local secrets / credentials
secrets/
