      },
      "source_file": "detection-rules/sigma/discovery/T1046_network_scan.yml"
    },
    {
      "id": "b3e7c1d4-5a2f-4b9e-c7d2-3f9e1a7c4b2d",
      "title": "WMI Remote Code Execution",
      "status": "production",
      "severity": "high",
      "tags": [
        "attack.execution",
        "attack.t1047",
        "attack.lateral_movement"
      ],
      "description": "Detects WMI usage for remote execution \u2014 common APT lateral movement",
      "logsource": {
        "category": "process_creation",
        "product": "windows"
      },
      "query": {
        "bool": {
          "must": [
            {
              "wildcard": {
                "Image": {
                  "value": "*\\wmic.exe"
                }
              }
            },
            {
              "bool": {
                "should": [
                  {
                    "match_phrase": {
                      "CommandLine": "/node:"
                    }
                  },
                  {
                    "match_phrase": {
                      "CommandLine": "process call create"
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            }
          ]
        }
      },
      "source_file": "detection-rules/sigma/execution/T1047_wmi_execution.yml"
    },
    {
      "id": "a2fbc6b2-4a3e-41b7-8e6c-2f1d9c0e5a3f",
      "title": "Suspicious Encoded PowerShell Execution",
      "status": "production",
      "severity": "high",
      "tags": [
        "attack.execution",
        "attack.t1059.001",
        "attack.defense_evasion",
        "attack.t1027"
      ],
      "description": "Detects PowerShell with encoded/obfuscated commands \u2014 fileless malware, droppers",
      "logsource": {
        "category": "process_creation",
        "product": "windows"
      },
      "query": {
        "bool": {
          "must": [
            {
              "wildcard": {
                "Image": {
                  "value": "*\\powershell.exe"
                }
              }
            },
            {
              "bool": {
                "should": [
                  {
                    "match_phrase": {
                      "CommandLine": "-EncodedCommand"
                    }
                  },
                  {
                    "match_phrase": {
                      "CommandLine": "-enc "
                    }
                  },
                  {
                    "match_phrase": {
                      "CommandLine": "IEX("
                    }
                  },
                  {
                    "match_phrase": {
                      "CommandLine": "Invoke-Expression"
                    }
                  },
                  {
                    "match_phrase": {
                      "CommandLine": "DownloadString"
                    }
                  },
                  {
                    "match_phrase": {
                      "CommandLine": "FromBase64String"
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            }
          ]
        }
      },
      "source_file": "detection-rules/sigma/execution/T1059.001_encoded_powershell.yml"
    },
    {
      "id": "l3o7m1n4-5k2j-3l9o-m7n2-3p9o2k7n4l0o",
      "title": "Data Exfiltration via C2 Channel",
      "status": "production",
      "severity": "medium",
      "tags": [
        "attack.exfiltration",
        "attack.t1041"
      ],
      "description": "Detects large outbound data transfers to suspicious external IPs",
      "logsource": {
        "category": "network_connection",
        "product": "zeek"
      },
      "query": {
        "bool": {
          "must": [
            {
              "term": {
                "local_orig": true
              }
            },
            {
              "term": {
                "local_resp": false
              }
            },
            {
              "term": {
                "orig_bytes": 5000000
              }
            }
          ],
          "must_not": [
            {
              "bool": {
                "should": [
                  {
                    "match_phrase": {
                      "resp_h": "1.1.1.1"
                    }
                  },
                  {
                    "match_phrase": {
                      "resp_h": "8.8.8.8"
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            }
          ]
        }
      },
      "source_file": "detection-rules/sigma/exfiltration/T1041_c2_exfil.yml"
    },
    {
      "id": "h9k3i7j0-1g8f-9h5k-i3j8-9l5k8g3j0h6k",
      "title": "Lateral Movement via SMB",
      "status": "production",
      "severity": "medium",
      "tags": [
        "attack.lateral_movement",
        "attack.t1021.002"
      ],
      "description": "Detects lateral movement via SMB file shares",
      "logsource": {
        "category": "network_connection",
        "product": "windows"
      },
      "query": {
        "bool": {
          "must": [
            {
              "term": {
                "EventID": 3
              }
            },
            {
              "term": {
                "DestinationPort": 445
              }
            },
            {
              "match_phrase": {
                "Initiated": "true"
              }
            }
          ],
          "must_not": [
            {
              "bool": {
                "should": [
                  {
                    "wildcard": {
                      "Image": {
                        "value": "*\\explorer.exe"
                      }
                    }
                  },
                  {
                    "wildcard": {
                      "Image": {
                        "value": "*\\svchost.exe"
                      }
                    }
                  },
                  {
                    "wildcard": {
                      "Image": {
                        "value": "*\\System"
                      }
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            }
          ]
        }
      },
      "source_file": "detection-rules/sigma/lateral-movement/T1021.002_smb_lateral.yml"
    },
    {
      "id": "i0l4j8k1-2h9g-0i6l-j4k9-0m6l9h4k1i7l",
      "title": "Pass-the-Hash Attack",
      "status": "production",
      "severity": "high",
      "tags": [
        "attack.lateral_movement",
        "attack.t1550.002"
      ],
      "description": "Detects pass-the-hash attacks using harvested NTLM hashes",
      "logsource": {
        "product": "windows",
        "service": "security"
      },
      "query": {
        "bool": {
          "must": [
            {
              "term": {
                "EventID": 4624
              }
            },
            {
              "term": {
                "LogonType": 3
              }
            },
            {
              "match_phrase": {
                "AuthenticationPackageName": "NTLM"
              }
            },
            {
              "term": {
                "KeyLength": 0
              }
            }
          ],
          "must_not": [
            {
              "wildcard": {
                "SubjectUserName": {
                  "value": "*$"
                }
              }
            }
          ]
        }
      },
      "source_file": "detection-rules/sigma/lateral-movement/T1550.002_pass_the_hash.yml"
    },
