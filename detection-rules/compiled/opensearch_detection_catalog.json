                "EventID": 4625
              }
            }
          ]
        }
      },
      "source_file": "detection-rules/sigma/credential-access/T1110_brute_force.yml"
    },
    {
      "id": "g8j2h6i9-0f7e-8g4j-h2i7-8k4j7f2i9g5j",
      "title": "LLMNR/NBT-NS Poisoning \u2014 Responder Activity",
      "status": "production",
      "severity": "medium",
      "tags": [
        "attack.credential_access",
        "attack.t1557.001"
      ],
      "description": "Detects LLMNR/NBT-NS poisoning attacks \u2014 Responder tool usage",
      "logsource": {
        "category": "network_connection",
        "product": "zeek"
      },
      "query": {
        "bool": {
          "must": [
            {
              "term": {
                "resp_p": 5355
              }
            },
            {
              "match_phrase": {
                "proto": "udp"
              }
            },
            {
              "term": {
                "resp_p": 137
              }
            },
            {
              "match_phrase": {
                "proto": "udp"
              }
            }
          ]
        }
      },
      "source_file": "detection-rules/sigma/credential-access/T1557_llmnr_poison.yml"
    },
    {
      "id": "j1m5k9l2-3i0h-1j7m-k5l0-1n7m0i5l2j8m",
      "title": "Windows Defender Disabled",
      "status": "production",
      "severity": "high",
      "tags": [
        "attack.defense_evasion",
        "attack.t1562.001"
      ],
      "description": "Detects attempts to disable Windows Defender real-time protection",
      "logsource": {
        "category": "process_creation",
        "product": "windows"
      },
      "query": {
        "bool": {
          "must": [
            {
              "bool": {
                "should": [
                  {
                    "match_phrase": {
                      "CommandLine": "Set-MpPreference -DisableRealtimeMonitoring $true"
                    }
                  },
                  {
                    "match_phrase": {
                      "CommandLine": "sc stop WinDefend"
                    }
                  },
                  {
                    "match_phrase": {
                      "CommandLine": "sc config WinDefend start=disabled"
                    }
                  }
                ],
                "minimum_should_match": 1
              }
            },
            {
              "match_phrase": {
                "TargetObject": "\\Windows Defender\\DisableAntiSpyware"
              }
            },
            {
              "match_phrase": {
                "Details": "DWORD (0x00000001)"
              }
            }
          ]
        }
      },
      "source_file": "detection-rules/sigma/defense-evasion/T1562.001_defender_disable.yml"
    },
    {
      "id": "k2n6l0m3-4j1i-2k8n-l6m1-2o8n1j6m3k9n",
      "title": "Network Port Scan (Zeek detection)",
      "status": "production",
      "severity": "medium",
      "tags": [
        "attack.discovery",
        "attack.t1046"
      ],
      "description": "Detects horizontal and vertical network scanning activity",
      "logsource": {
        "category": "network_connection",
